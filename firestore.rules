rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin based on their email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'hearhelper@gmail.com';
    }

    match /users/{userId} {
      // Authenticated users can read user profiles (needed for the Community Contact list)
      allow read: if request.auth != null;
      
      // Users can only create their own document matching their Auth UID
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can update their own profile; Admin has override permissions
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Only admin can delete user records
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      // PROPER RESTRICTION: Only Admin can read the feedback collection
      allow read: if isAdmin();
      
      // Users must be authenticated to submit feedback (prevents spam and helps with tracking)
      allow create: if request.auth != null;
      
      // Feedback entries are immutable for users; only admin can manage/delete them
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      // PRIVACY: Users can read/list messages they are participating in
      allow read, list: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // AUTHENTICATED WRITE: Users can only send messages as themselves and must be a participant
      allow create: if request.auth != null 
                    && request.resource.data.senderId == request.auth.uid
                    && request.auth.uid in request.resource.data.participants;
      
      // Admin bypass for listing/moderation
      allow read, list: if isAdmin();
      
      // Messages are immutable for users to prevent history tampering
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
